# DRISHTI Backend Environment Configuration Template
PROJECT_NAME="DRISHTI Compliance Risk Intelligence Platform"
VERSION=0.1.0
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

# PostgreSQL Settings
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=drishti

# Allowed CORS Origins (JSON list format)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
