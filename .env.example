# ==============================================================================
# DRISHTI Platform Environment Variables Template
# Copy this file to .env and configure values for local development.
# ==============================================================================

# Backend Service Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
DEBUG=true

# Database Infrastructure (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=drishti

# Optional full database URL (overrides individual POSTGRES_* settings if set)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drishti

# CORS Settings (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Frontend Next.js Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="DRISHTI - Product Compliance Risk Intelligence"
NEXT_PUBLIC_ENVIRONMENT=development
